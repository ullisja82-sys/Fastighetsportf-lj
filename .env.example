# Kopiera till .env och fyll i. .env checkas aldrig in.

# Appens adress utifrån (bakom HTTPS-proxyn på servern).
APP_URL=https://fastighetsportfolj.hfab.se

# Personlig inloggning via Entra ID (OpenID Connect). Lämna tomt = ingen inloggning.
# Appregistrering (webbplattform):
#   Omdirigerings-URI:      https://fastighetsportfolj.hfab.se/auth/callback
#   Utloggnings-URL:        https://fastighetsportfolj.hfab.se/utloggad
#   Behörigheter (delegerade): openid, profile, email
# Begränsa åtkomsten i företagsappen: "Tilldelning krävs" = Ja och tilldela användare/grupper.
# Katalog-ID (klientorganisation), under Översikt i appregistreringen
ENTRA_TENANT_ID=
# Program-ID (klient), under Översikt i appregistreringen
ENTRA_CLIENT_ID=
# Värdet (inte ID:t) från Certifikat och hemligheter -> Ny klienthemlighet
ENTRA_CLIENT_SECRET=

# Lång slumpsträng som signerar inloggningskakan:  openssl rand -base64 48
SESSION_SECRET=

# Vilken adress port 8405 binds till. 0.0.0.0 behövs för att proxyn ska nå appen.
BIND_ADDRESS=0.0.0.0
